# Shared Supabase transaction pooler only. Never expose with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# One socket per instance by default, hard maximum 2. Not a global deployment cap.
PG_POOL_MAX=1
# Optional PEM CA for verified TLS if required by your database certificate.
# PG_SSL_CA=
# Existing CRM credentials, server-side only; read-only identity/role/lead checks.
# Import these from CRM Automations with npm run setup:env.
TWENTY_CRM_BASE_URL=
TWENTY_CRM_API_KEY=
# No access until a key is registered. Store SHA-256 hashes, never plaintext keys.
CONTEXT_API_KEYS_JSON=[]
# Example registration (generate using npm run keys:create):
# [{"id":"sales-trial","hash":"<64 hex characters>","employeeEmail":"person@wareongo.com","scopes":["knowledge:read","warehouses:read","crm:read"],"expiresAt":"2026-10-25T00:00:00.000Z"}]
# Optional comma-separated browser origins, exact scheme+host+port; no wildcard.
CONTEXT_ALLOWED_ORIGINS=
# Per key per process; supplement with deployment-wide edge rate limits.
CONTEXT_REQUESTS_PER_MINUTE=30
# Browser console: one administrator password, server-side only.
# Generate a random password with npm run setup:console -- --email EMAIL.
CONTEXT_ADMIN_EMAIL=
CONTEXT_ADMIN_PASSWORD=
CONTEXT_CONSOLE_ORIGIN=http://localhost:3100
# Generate independent 32-byte base64url secrets with npm run setup:console.
CONTEXT_SESSION_SECRET=
CONTEXT_KEY_ENCRYPTION_SECRET=
# Optional dashboard admin override for employee API permissions.
ADMIN_EMAILS=
# Leave disabled until the separate console migration is applied deliberately.
CONTEXT_CONSOLE_WRITES_ENABLED=false

# Remote MCP uses the same console origin, secrets, and private storage flag.
# Apply scripts/migrate-mcp-oauth.mjs --apply before using OAuth connections.
# Optional kill switch: unset enables MCP when setup is complete; false disables it.
# CONTEXT_MCP_ENABLED=false
# Optional additional exact HTTPS callback origins for other trusted clients.
# Built-in Claude callback rules apply without this setting; never use a wildcard.
CONTEXT_MCP_ALLOWED_REDIRECT_ORIGINS=
